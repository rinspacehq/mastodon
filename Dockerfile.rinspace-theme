# Compatible assets maintenance on the accepted parent-session recovery runtime.
# Load the exact base from its public release before building with --network none.
FROM rinspace-mastodon-parent-recovery@sha256:054857f92b319ef195831a18a3a65a71ac8b34f869a24395c6ac4e2bf8b1ad1a
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.source="https://github.com/rinspacehq/mastodon" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      com.rinspace.release.component="mastodon-shared-theme" \
      com.rinspace.release.base="sha256:054857f92b319ef195831a18a3a65a71ac8b34f869a24395c6ac4e2bf8b1ad1a"
COPY --chown=mastodon:mastodon app/javascript/inline/theme-selection.js /opt/mastodon/app/javascript/inline/theme-selection.js
COPY --chown=mastodon:mastodon public/packs/ /opt/mastodon/public/packs/
