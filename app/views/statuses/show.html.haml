- content_for :page_title, t('statuses.title', name: display_name(@account), quote: truncate(@status.spoiler_text.presence || @status.text, length: 50, omission: '…', escape: false))

- content_for :header_tags do
  - unless @search_index_eligibility&.eligible?
    %meta{ name: 'robots', content: 'noindex, noarchive' }/
  - else
    = render_seo_schema @status

  %link{ rel: 'canonical', href: canonical_rinspace_status_url(@status.id, Rinspace::StatusSlug.for(@status)) }/
  %link{ rel: 'alternate', type: 'application/json+oembed', href: api_oembed_url(url: canonical_rinspace_status_url(@status.id, Rinspace::StatusSlug.for(@status)), format: 'json') }/
  - unless Mastodon::RinspaceLocalOnly.enabled?
    %link{ rel: 'alternate', type: 'application/activity+json', href: ActivityPub::TagManager.instance.uri_for(@status) }/
    %link{ rel: 'alternate', type: 'application/ld+json; profile="https://www.w3.org/ns/activitystreams"', href: ActivityPub::TagManager.instance.uri_for(@status) }/

  = opengraph 'og:site_name', metadata_site_name
  = opengraph 'og:type', 'article'
  = opengraph 'og:title', "#{display_name(@account)} (#{acct(@account)})"
  = opengraph 'og:url', canonical_rinspace_status_url(@status.id, Rinspace::StatusSlug.for(@status))
  = opengraph 'og:published_time', @status.created_at.iso8601
  - if @status.language.present?
    = opengraph 'og:locale', @status.language
  = opengraph 'profile:username', acct(@account)[1..]

  = render 'og_description', activity: @status
  = render 'og_image', status: @status, account: @account

- content_for :rinspace_public_snapshot do
  %main.rinspace-search-snapshot{ data: { rin_public_document: 'tweet', rin_object_id: @status.id, rin_public_version: "status:#{@status.id}:#{(@status.edited_at || @status.created_at).to_i}" } }
    %article{ aria: { labelledby: 'rinspace-tweet-title' } }
      %h1#rinspace-tweet-title= t('statuses.title', name: display_name(@account), quote: '')
      %p
        = link_to acct(@account), short_account_path(@account), rel: 'author'
        %time{ datetime: @status.created_at.iso8601 }= l(@status.created_at)
      .status__content{ data: { rin_primary_text: 'tweet' } }= status_content_format(@status)
      - if @rinspace_knowledge_tags.present?
        %nav{ aria: { label: '相关知识 Tag' } }
          %span 相关知识 Tag：
          - @rinspace_knowledge_tags.each do |tag|
            = link_to tag.name, tag.url, rel: 'tag'

= render 'shared/web_app'
