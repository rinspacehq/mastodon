- description ||= Mastodon::RinspaceLocalOnly.enabled? ? rinspace_site_description : (instance_presenter.description.presence || strip_tags(t('about.about_mastodon_html')))
- preview_width, preview_height = instance_preview_dimensions

%meta{ name: 'description', content: description }/

= opengraph 'og:site_name', metadata_site_name
= opengraph 'og:url', url_for(only_path: false)
= opengraph 'og:type', 'website'
= opengraph 'og:title', instance_presenter.title
= opengraph 'og:description', description
= opengraph 'og:image', instance_preview_url
= opengraph 'og:image:width', preview_width
= opengraph 'og:image:height', preview_height
= opengraph 'twitter:card', 'summary_large_image'
